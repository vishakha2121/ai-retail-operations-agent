*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================
# VIRTUAL ENVIRONMENTS
# ============================================================
venv/
env/
ENV/
.venv/
.env.docker
*.venv
pyvenv.cfg
pip-log.txt
pip-delete-this-directory.txt

# ============================================================
# PYTEST / TESTING
# ============================================================
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ============================================================
# JUPYTER NOTEBOOKS
# ============================================================
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================================
# NODE / REACT / VITE
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite
dist/
dist-ssr/
.vite/
*.local

# NPM / Yarn / pnpm
.npm
.yarn/
.pnp
.pnp.js
.yarn-integrity

# ============================================================
# FRONTEND BUILD OUTPUT
# ============================================================
frontend/dist/
frontend/build/
frontend/node_modules/
frontend/.vite/
frontend/.cache/

# ============================================================
# BACKEND BUILD OUTPUT
# ============================================================
backend/build/
backend/dist/
backend/*.egg-info/

# ============================================================
# ENVIRONMENT VARIABLES (SECRETS - NEVER COMMIT!)
# ============================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ============================================================
# DATABASE
# ============================================================
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
retail.db
database/*.db
database/*.sqlite
database/*.sqlite3

# ============================================================
# MACHINE LEARNING MODELS (Large files)
# ============================================================
*.pkl
*.pickle
*.h5
*.hdf5
*.joblib
*.model
*.weights
*.onnx
*.pb
*.tflite

backend/data/models_saved/*
!backend/data/models_saved/.gitkeep

# ============================================================
# DATA FILES (Large CSVs)
# ============================================================
*.csv
*.tsv
*.parquet
*.feather
*.xlsx
*.xls

# But keep small sample data
!backend/data/raw/*.sample.csv
!backend/data/raw/.gitkeep
!backend/data/processed/.gitkeep

# ============================================================
# LOGS
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
backend/logs/
frontend/logs/

# ============================================================
# IDE / EDITOR
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

