!README.md
!LICENSE
!.gitignore
!requirements.txt
!package.json
!package-lock.json
!*.example

__pycache__/
*.pyc
.env
venv/
env/
*.egg-info/

node_modules/
dist/
build/
.vite/

*.db
*.sqlite3
*.pkl

.vscode/
.idea/
*.log
